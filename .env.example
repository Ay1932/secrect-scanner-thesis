# Copy this file to .env and fill in real values. Never commit .env itself.

# "ollama" for the free local model (recommended primary), or "hosted" for the Anthropic API
LLM_BACKEND=ollama

# Only needed if LLM_BACKEND=ollama and you're not using the defaults
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Only needed if LLM_BACKEND=hosted
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Only needed for data/fetch_repos.py (raises your GitHub API rate limit a lot)
GITHUB_TOKEN=
